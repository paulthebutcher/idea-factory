# Copy to .env and fill in. Never commit .env. Key values are never printed or logged.
ANTHROPIC_API_KEY=
# Required when the key above is not scoped to a workspace (the API rejects requests without it).
# Find it in the Anthropic Console under Workspaces (starts with wrkspc_).
ANTHROPIC_WORKSPACE_ID=
EXA_API_KEY=
BRAVE_API_KEY=
# Per-run spend ceiling. The runner stops with status budget_exceeded when reached.
RUN_BUDGET_USD=20
# live | record | replay. Acceptance tests always use replay.
SEARCH_MODE=replay
# Optional. live | record | replay for model calls. Defaults to SEARCH_MODE.
# MODEL_MODE=replay
